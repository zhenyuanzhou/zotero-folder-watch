{
	"manifest_version": 2,
	"name": "Folder Watch",
	"version": "1.3.0",
	"description": "Monitors a folder and automatically imports new PDFs into your Zotero library.",
	"author": "automanzzy",
	"icons": {
		"48": "icon.svg",
		"96": "icon.svg"
	},
	"applications": {
		"zotero": {
			"id": "folderwatch@automanzzy",
			"update_url": "https://raw.githubusercontent.com/zhenyuanzhou/zotero-folder-watch/main/updates.json",
			"strict_min_version": "6.999",
			"strict_max_version": "11.*"
		}
	}
}
